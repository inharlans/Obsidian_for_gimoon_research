# Public PaperKG endpoint behind a TLS reverse proxy.
PAPERKG_PUBLIC_BASE_URL=https://paperkg.example.com
PAPERKG_HOST_VAULT_PATH=/srv/paperkg/vault/PaperKG
PAPERKG_REINDEX_INTERVAL_MS=60000

# OAuth 2.1 / OpenID Connect authorization server.
PAPERKG_OAUTH_ISSUER=https://auth.example.com/realms/paperkg
PAPERKG_OAUTH_AUDIENCE=https://paperkg.example.com

# Usually discovered from the issuer. Override only when provider metadata omits them.
# PAPERKG_OAUTH_JWKS_URI=https://auth.example.com/realms/paperkg/protocol/openid-connect/certs
# PAPERKG_OAUTH_AUTHORIZATION_ENDPOINT=https://auth.example.com/realms/paperkg/protocol/openid-connect/auth
# PAPERKG_OAUTH_TOKEN_ENDPOINT=https://auth.example.com/realms/paperkg/protocol/openid-connect/token
# PAPERKG_OAUTH_REGISTRATION_ENDPOINT=https://auth.example.com/realms/paperkg/clients-registrations/openid-connect
# PAPERKG_OAUTH_REVOCATION_ENDPOINT=https://auth.example.com/realms/paperkg/protocol/openid-connect/revoke
