{
  "name": "paperkg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:cloudflare-node && pnpm test:core && pnpm test:mcp",
    "test:cloudflare-node": "vitest run --config vitest.cloudflare.config.ts",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:worker && pnpm build && pnpm paperkg validate vault/PaperKG && pnpm paperkg audit vault/PaperKG --fail-on high",
    "paperkg": "tsx packages/cli/src/index.ts",
    "dev:preview": "vite --config apps/preview/vite.config.ts",
    "build:preview": "vite build --config apps/preview/vite.config.ts",
    "mcp:stdio": "tsx packages/mcp/src/index.ts stdio",
    "mcp:http": "tsx packages/mcp/src/index.ts http",
    "cloudflare:dev": "pnpm --dir apps/cloudflare-worker dev",
    "cloudflare:deploy": "pnpm --dir apps/cloudflare-worker run deploy",
    "cloudflare:snapshot": "node scripts/build-cloudflare-snapshot.mjs",
    "cloudflare:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-paperkg-cloudflare.ps1",
    "cloudflare:pull-meetings": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pull-paperkg-meeting-candidates.ps1",
    "cloudflare:set-oauth-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-paperkg-cloudflare-oauth-secrets.ps1",
    "cloudflare:smoke-oauth": "node scripts/smoke-cloudflare-oauth.mjs",
    "cloudflare:check-account-switch": "node scripts/check-paperkg-account-portability.mjs",
    "test:mcp-http": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mcp-smoke.ps1",
    "zotero:drive-plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zotero-google-drive-plan.ps1",
    "install:plugin": "tsx scripts/install-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.17"
    }
  }
}
